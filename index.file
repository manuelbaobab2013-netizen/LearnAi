<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LearnAI</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background: #f4f7ff;
      color: #172033;
      min-height: 100vh;
    }

    button {
      border: none;
      cursor: pointer;
    }

    /* LANDING PAGE */
    .gate {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 30px;
      background: linear-gradient(135deg, #eef4ff, #ffffff);
    }

    .gate h1 {
      font-size: clamp(42px, 7vw, 76px);
      color: #3157d5;
      margin-bottom: 18px;
      letter-spacing: -2px;
    }

    .gate p {
      max-width: 720px;
      font-size: 18px;
      line-height: 1.7;
      color: #596579;
      margin-bottom: 35px;
    }

    .about {
      max-width: 720px;
      margin-bottom: 38px;
    }

    .about h2 {
      margin-bottom: 12px;
      color: #202b45;
    }

    .primary-btn {
      background: #3157d5;
      color: white;
      padding: 15px 32px;
      border-radius: 12px;
      font-size: 16px;
      font-weight: bold;
      transition: .2s;
    }

    .primary-btn:hover {
      transform: translateY(-2px);
      opacity: .92;
    }

    /* AUTH */
    .auth {
      display: none;
      min-height: 100vh;
      align-items: center;
      justify-content: center;
      padding: 25px;
    }

    .auth-card {
      width: min(430px, 100%);
      background: white;
      padding: 35px;
      border-radius: 20px;
      box-shadow: 0 12px 40px rgba(30, 50, 100, .12);
    }

    .auth-card h2 {
      color: #3157d5;
      margin-bottom: 10px;
    }

    .auth-card p {
      color: #697386;
      margin-bottom: 25px;
    }

    .input {
      width: 100%;
      padding: 13px;
      border: 1px solid #d7ddea;
      border-radius: 10px;
      margin-bottom: 14px;
      font-size: 15px;
      outline: none;
    }

    .input:focus {
      border-color: #3157d5;
    }

    .auth-switch {
      text-align: center;
      margin-top: 18px;
      color: #687389;
    }

    .auth-switch span {
      color: #3157d5;
      font-weight: bold;
      cursor: pointer;
    }

    /* APP */
    .app {
      display: none;
      min-height: 100vh;
    }

    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      width: 235px;
      background: #17254d;
      color: white;
      padding: 25px 15px;
      display: flex;
      flex-direction: column;
      z-index: 10;
    }

    .logo {
      font-size: 26px;
      font-weight: bold;
      padding: 5px 12px 25px;
    }

    .nav {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .nav button,
    .bottom-nav button {
      background: transparent;
      color: #dce5ff;
      text-align: left;
      padding: 12px 14px;
      border-radius: 9px;
      font-size: 14px;
    }

    .nav button:hover,
    .nav button.active,
    .bottom-nav button:hover {
      background: #2e4381;
      color: white;
    }

    .bottom-nav {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .main {
      margin-left: 235px;
      min-height: 100vh;
    }

    .topbar {
      height: 72px;
      background: white;
      border-bottom: 1px solid #e4e8f2;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 18px;
      padding: 0 28px;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 13px;
      color: #687389;
    }

    .dot {
      width: 9px;
      height: 9px;
      background: #26b86a;
      border-radius: 50%;
    }

    .account {
      font-weight: bold;
    }

    .content {
      padding: 30px;
      max-width: 1300px;
      margin: auto;
    }

    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    .welcome {
      background: linear-gradient(135deg, #3157d5, #657df0);
      color: white;
      padding: 32px;
      border-radius: 20px;
      margin-bottom: 25px;
    }

    .welcome h1 {
      margin-bottom: 10px;
    }

    .welcome p {
      opacity: .9;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 18px;
      margin-bottom: 25px;
    }

    .card {
      background: white;
      border-radius: 17px;
      padding: 22px;
      box-shadow: 0 5px 22px rgba(30, 50, 100, .07);
    }

    .card h3 {
      margin-bottom: 8px;
    }

    .number {
      font-size: 30px;
      font-weight: bold;
      color: #3157d5;
    }

    .muted {
      color: #738097;
      font-size: 14px;
    }

    /* TUTOR */
    .tutor-box {
      background: white;
      border-radius: 18px;
      padding: 25px;
      box-shadow: 0 5px 22px rgba(30, 50, 100, .07);
    }

    .robot {
      width: 65px;
      height: 65px;
      border-radius: 18px;
      background: #e7edff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      margin-bottom: 15px;
    }

    .subjects {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 10px;
      margin: 20px 0;
    }

    .subject {
      padding: 13px;
      background: #f1f4ff;
      border-radius: 10px;
      color: #3157d5;
      font-weight: bold;
    }

    .chat {
      min-height: 270px;
      background: #f7f9fd;
      border-radius: 13px;
      padding: 18px;
      margin-bottom: 15px;
      overflow-y: auto;
    }

    .message {
      padding: 12px 15px;
      border-radius: 13px;
      margin-bottom: 10px;
      max-width: 80%;
      line-height: 1.5;
    }

    .ai {
      background: #e9edff;
    }

    .user {
      background: #3157d5;
      color: white;
      margin-left: auto;
    }

    .chat-input {
      display: flex;
      gap: 10px;
    }

    .chat-input input {
      flex: 1;
      padding: 14px;
      border: 1px solid #d7ddea;
      border-radius: 10px;
      outline: none;
    }

    /* GENERATOR */
    .generator-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 15px;
    }

    .generator-card {
      background: white;
      padding: 22px;
      border-radius: 15px;
      border: 1px solid #e5e9f3;
      cursor: pointer;
      transition: .2s;
    }

    .generator-card:hover {
      transform: translateY(-3px);
      border-color: #3157d5;
    }

    .generator-card h3 {
      margin-bottom: 8px;
    }

    /* SETTINGS */
    .setting {
      background: white;
      padding: 20px;
      border-radius: 14px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    select {
      padding: 9px;
      border: 1px solid #d7ddea;
      border-radius: 8px;
    }

    /* MOBILE */
    @media (max-width: 800px) {
      .sidebar {
        width: 75px;
      }

      .logo {
        font-size: 0;
      }

      .logo::after {
        content: "L";
        font-size: 25px;
      }

      .nav button,
      .bottom-nav button {
        font-size: 0;
        text-align: center;
      }

      .nav button::first-letter,
      .bottom-nav button::first-letter {
        font-size: 18px;
      }

      .main {
        margin-left: 75px;
      }

      .topbar {
        padding: 0 12px;
      }

      .content {
        padding: 18px;
      }
    }
  </style>
</head>

<body>

  <!-- MAIN GATE -->
  <section class="gate" id="gate">
    <h1>WELCOME TO LEARNAI</h1>

    <p>
      LearnAI is a smart learning platform that helps students understand
      difficult ideas, practise school subjects, revise effectively and
      track their real learning progress.
    </p>

    <div class="about">
      <h2>About LearnAI</h2>
      <p>
        LearnAI helps students learn school subjects at their own level.
        It explains difficult topics clearly, gives practice activities,
        helps with revision and supports students as they improve.
      </p>
    </div>

    <button class="primary-btn" onclick="showAuth()">GET STARTED</button>
  </section>

  <!-- LOGIN / SIGN UP -->
  <section class="auth" id="auth">
    <div class="auth-card">
      <h2 id="authTitle">Welcome to LearnAI</h2>
      <p id="authText">Sign in to continue learning.</p>

      <input class="input" id="nameInput" placeholder="Your name" style="display:none;">
      <input class="input" id="emailInput" type="email" placeholder="Email">
      <input class="input" id="passwordInput" type="password" placeholder="Password">

      <button class="primary-btn" style="width:100%;" onclick="login()">
        <span id="authButton">Log In</span>
      </button>

      <div class="auth-switch">
        <span id="switchText">Don't have an account? </span>
        <span onclick="toggleAuth()" id="switchButton">Sign Up</span>
      </div>
    </div>
  </section>

  <!-- MAIN APPLICATION -->
  <section class="app" id="app">

    <aside class="sidebar">
      <div class="logo">LearnAI</div>

      <div class="nav">
        <button class="active" onclick="openPage('home', this)">🏠 Home</button>
        <button onclick="openPage('progress', this)">📈 Progress</button>
        <button onclick="openPage('tutor', this)">🤖 AI Tutor</button>
        <button onclick="openPage('generator', this)">✨ AI Generator</button>
        <button onclick="openPage('worksheets', this)">📄 Worksheets</button>
        <button onclick="openPage('revision', this)">📚 Revision</button>
        <button onclick="openPage('tests', this)">📝 Practice Tests</button>
      </div>

      <div class="bottom-nav">
        <button onclick="openPage('conversation', this)">💬 Conversation</button>
        <button onclick="openPage('settings', this)">⚙️ Settings</button>
      </div>
    </aside>

    <main class="main">

      <header class="topbar">
        <div class="status">
          <span class="dot"></span>
          Online
        </div>

        <div class="account" id="accountName">Student</div>
      </header>

      <div class="content">

        <!-- HOME -->
        <section class="page active" id="home">
          <div class="welcome">
            <h1>Welcome to LearnAI 👋</h1>
            <p>Learn → Practice → Test → Progress → Improve</p>
          </div>

          <div class="cards">
            <div class="card">
              <h3>Activities Completed</h3>
              <div class="number" id="activities">0</div>
              <div class="muted">Real completed activities</div>
            </div>

            <div class="card">
              <h3>Average Score</h3>
              <div class="number" id="score">—</div>
              <div class="muted">Based on completed tests</div>
            </div>

            <div class="card">
              <h3>Study Time</h3>
              <div class="number" id="minutes">0</div>
              <div class="muted">Minutes recorded</div>
            </div>

            <div class="card">
              <h3>Streak</h3>
              <div class="number" id="streak">0</div>
              <div class="muted">Learning days</div>
            </div>
          </div>

          <div class="card">
            <h2>Start Learning</h2>
            <p class="muted" style="margin:10px 0 18px;">
              Choose AI Tutor to start learning a subject at your level.
            </p>
            <button class="primary-btn" onclick="openPage('tutor')">
              Open AI Tutor
            </button>
          </div>
        </section>

        <!-- PROGRESS -->
        <section class="page" id="progress">
          <h1>Progress</h1>
          <p class="muted" style="margin:8px 0 22px;">
            Your progress is based only on activities you actually complete.
          </p>

          <div class="cards">
            <div class="card">
              <h3>Completed</h3>
              <div class="number" id="progressActivities">0</div>
            </div>

            <div class="card">
              <h3>Study Minutes</h3>
              <div class="number" id="progressMinutes">0</div>
            </div>

            <div class="card">
              <h3>Best Score</h3>
              <div class="number" id="bestScore">—</div>
            </div>
          </div>

          <div class="card">
            <h2>Learning Areas</h2>
            <p class="muted" style="margin-top:10px;">
              Complete lessons, worksheets and tests to build your real progress record.
            </p>
          </div>
        </section>

        <!-- AI TUTOR -->
        <section class="page" id="tutor">
          <h1>AI Tutor</h1>
          <p class="muted" style="margin:8px 0 20px;">
            Ask questions and get explanations matched to your learning level.
          </p>

          <div class="tutor-box">
            <div class="robot">🤖</div>

            <h2>Choose a subject</h2>

            <div class="subjects">
              <button class="subject" onclick="chooseSubject('Maths')">Maths</button>
              <button class="subject" onclick="chooseSubject('English')">English</button>
              <button class="subject" onclick="chooseSubject('Science')">Science</button>
              <button class="subject" onclick="chooseSubject('History')">History</button>
              <button class="subject" onclick="chooseSubject('Geography')">Geography</button>
              <button class="subject" onclick="chooseSubject('Computer Science')">Computer Science</button>
              <button class="subject" onclick="chooseSubject('Biology')">Biology</button>
              <button class="subject" onclick="chooseSubject('Physics')">Physics</button>
            </div>

            <button class="primary-btn" onclick="newChat()" style="margin-bottom:15px;">
              + New Chat
            </button>

            <div class="chat" id="chat">
              <div class="message ai">
                Hi! I'm your LearnAI Tutor. Choose a subject and ask me a question.
                I'll explain it step by step and at your level.
              </div>
            </div>

            <div class="chat-input">
              <input id="question" placeholder="Ask your question..." onkeydown="handleEnter(event)">
              <button class="primary-btn" onclick="sendMessage()">Send</button>
            </div>
          </div>
        </section>

        <!-- GENERATOR -->
        <section class="page" id="generator">
          <h1>AI Generator</h1>
          <p class="muted" style="margin:8px 0 22px;">
            Create learning materials for your subjects.
          </p>

          <div class="generator-grid">
            <div class="generator-card" onclick="generate('Worksheet')">
              <h3>📄 Worksheet</h3>
              <p class="muted">Create practice worksheets.</p>
            </div>

            <div class="generator-card" onclick="generate('Revision Notes')">
              <h3>📚 Revision Notes</h3>
              <p class="muted">Create clear study notes.</p>
            </div>

            <div class="generator-card" onclick="generate('Practice Test')">
              <h3>📝 Practice Test</h3>
              <p class="muted">Test your knowledge.</p>
            </div>

            <div class="generator-card" onclick="generate('Quiz')">
              <h3>❓ Quiz</h3>
              <p class="muted">Generate quick quizzes.</p>
            </div>

            <div class="generator-card" onclick="generate('Flashcards')">
              <h3>🗂️ Flashcards</h3>
              <p class="muted">Create flashcards.</p>
            </div>

            <div class="generator-card" onclick="generate('Study Plan')">
              <h3>📅 Study Plan</h3>
              <p class="muted">Build a study plan.</p>
            </div>

            <div class="generator-card" onclick="generate('Practice Questions')">
              <h3>✏️ Practice Questions</h3>
              <p class="muted">Generate questions.</p>
            </div>

            <div class="generator-card" onclick="generate('Learning Activity')">
              <h3>🧠 Learning Activity</h3>
              <p class="muted">Create another learning activity.</p>
            </div>
          </div>

          <div class="card" id="generatedContent" style="margin-top:22px; display:none;"></div>
        </section>

        <!-- WORKSHEETS -->
        <section class="page" id="worksheets">
          <h1>Worksheets</h1>
          <p class="muted" style="margin:8px 0 20px;">
            Your generated and saved worksheets will appear here.
          </p>

          <div class="card">
            <h2>No worksheets yet</h2>
            <p class="muted" style="margin:10px 0 18px;">
              Use AI Generator to create your first worksheet.
            </p>
            <button class="primary-btn" onclick="openPage('generator')">
              Create Worksheet
            </button>
          </div>
        </section>

        <!-- REVISION -->
        <section class="page" id="revision">
          <h1>Revision</h1>

          <div class="cards" style="margin-top:20px;">
            <div class="card">
              <h3>Revision Notes</h3>
              <p class="muted">Review important topics.</p>
            </div>

            <div class="card">
              <h3>Flashcards</h3>
              <p class="muted">Practise key facts.</p>
            </div>

            <div class="card">
              <h3>Quick Questions</h3>
              <p class="muted">Check your understanding.</p>
            </div>
          </div>
        </section>

        <!-- TESTS -->
        <section class="page" id="tests">
          <h1>Practice Tests</h1>

          <div class="card" style="margin-top:20px;">
            <h2>Ready to test yourself?</h2>
            <p class="muted" style="margin:10px 0 18px;">
              Generate a practice test and record your real score.
            </p>
            <button class="primary-btn" onclick="generate('Practice Test')">
              Generate Test
            </button>
          </div>
        </section>

        <!-- CONVERSATION -->
        <section class="page" id="conversation">
          <h1>Conversation</h1>

          <div class="card" style="margin-top:20px;">
            <h2>Saved Conversations</h2>
            <p class="muted" style="margin-top:10px;">
              Your saved AI Tutor conversations will appear here when persistence is connected.
            </p>
          </div>
        </section>

        <!-- SETTINGS -->
        <section class="page" id="settings">
          <h1>Settings</h1>

          <div style="margin-top:20px;">
            <div class="setting">
              <div>
                <strong>Language</strong>
                <div class="muted">Choose your learning language.</div>
              </div>

              <select>
                <option>English</option>
                <option>French</option>
                <option>Spanish</option>
                <option>Portuguese</option>
              </select>
            </div>

            <div class="setting">
              <div>
                <strong>Learning Level</strong>
                <div class="muted">AI explanations should match your level.</div>
              </div>

              <select id="level">
                <option>Beginner</option>
                <option>Intermediate</option>
                <option>Advanced</option>
              </select>
            </div>

            <div class="setting">
              <div>
                <strong>Notifications</strong>
                <div class="muted">Study reminders and learning updates.</div>
              </div>

              <input type="checkbox" checked>
            </div>

            <div class="setting">
              <div>
                <strong>Dark Mode</strong>
                <div class="muted">Change the appearance of LearnAI.</div>
              </div>

              <input type="checkbox" onchange="toggleDarkMode(this)">
            </div>

            <div class="setting">
              <div>
                <strong>Account</strong>
                <div class="muted">Manage your LearnAI account.</div>
              </div>

              <button class="primary-btn" onclick="logout()">Log Out</button>
            </div>
          </div>
        </section>

      </div>
    </main>
  </section>

  <script>
    let isSignup = false;
    let currentSubject = "General";
    let learningData = {
      activities: 0,
      minutes: 0,
      scores: []
    };

    function showAuth() {
      document.getElementById("gate").style.display = "none";
      document.getElementById("auth").style.display = "flex";
    }

    function toggleAuth() {
      isSignup = !isSignup;

      document.getElementById("authTitle").textContent =
        isSignup ? "Create your LearnAI account" : "Welcome to LearnAI";

      document.getElementById("authText").textContent =
        isSignup ? "Create an account to start learning." : "Sign in to continue learning.";

      document.getElementById("nameInput").style.display =
        isSignup ? "block" : "none";

      document.getElementById("authButton").textContent =
        isSignup ? "Sign Up" : "Log In";

      document.getElementById("switchText").textContent =
        isSignup ? "Already have an account? " : "Don't have an account? ";

      document.getElementById("switchButton").textContent =
        isSignup ? "Log In" : "Sign Up";
    }

    function login() {
      const name = document.getElementById("nameInput").value.trim();

      const studentName =
        isSignup && name
          ? name
          : "Student";

      document.getElementById("accountName").textContent = studentName;

      document.getElementById("auth").style.display = "none";
      document.getElementById("app").style.display = "block";

      updateProgress();
    }

    function logout() {
      document.getElementById("app").style.display = "none";
      document.getElementById("gate").style.display = "flex";
    }

    function openPage(pageId, button) {
      document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
      });

      const page = document.getElementById(pageId);

      if (page) {
        page.classList.add("active");
      }

      document.querySelectorAll(".nav button, .bottom-nav button").forEach(btn => {
        btn.classList.remove("active");
      });

      if (button) {
        button.classList.add("active");
      }
    }

    function chooseSubject(subject) {
      currentSubject = subject;

      const chat = document.getElementById("chat");

      chat.innerHTML += `
        <div class="message ai">
          Great! We're studying <strong>${subject}</strong>.
          Ask me anything about ${subject}, and I'll explain it step by step.
        </div>
      `;

      chat.scrollTop = chat.scrollHeight;
    }

    function newChat() {
      document.getElementById("chat").innerHTML = `
        <div class="message ai">
          New chat started. What would you like to learn?
        </div>
      `;
    }

    function handleEnter(event) {
      if (event.key === "Enter") {
        sendMessage();
      }
    }

    function sendMessage() {
      const input = document.getElementById("question");
      const question = input.value.trim();

      if (!question) return;

      const chat = document.getElementById("chat");

      chat.innerHTML += `
        <div class="message user">${escapeHTML(question)}</div>
      `;

      /*
        This is the front-end demonstration.
        A secure backend will later send this question to the real AI.
      */

      chat.innerHTML += `
        <div class="message ai">
          I understand your question about <strong>${currentSubject}</strong>.
          In the connected version, I'll give you a clear, step-by-step answer
          matched to your learning level.
        </div>
      `;

      input.value = "";
      chat.scrollTop = chat.scrollHeight;
    }

    function generate(type) {
      const box = document.getElementById("generatedContent");

      box.style.display = "block";

      box.innerHTML = `
        <h2>${type}</h2>
        <p class="muted" style="margin:10px 0 15px;">
          Your ${type.toLowerCase()} will be generated here by the connected LearnAI AI.
        </p>

        <p>
          <strong>Subject:</strong> ${currentSubject}
        </p>

        <p style="margin-top:10px;">
          <strong>Level:</strong>
          ${document.getElementById("level").value}
        </p>

        <button class="primary-btn" style="margin-top:18px;" onclick="completeActivity()">
          Mark Activity Complete
        </button>
      `;
    }

    function completeActivity() {
      learningData.activities += 1;
      learningData.minutes += 5;

      updateProgress();

      alert("Activity completed! Your progress has been updated.");
    }

    function updateProgress() {
      document.getElementById("activities").textContent =
        learningData.activities;

      document.getElementById("progressActivities").textContent =
        learningData.activities;

      document.getElementById("minutes").textContent =
        learningData.minutes;

      document.getElementById("progressMinutes").textContent =
        learningData.minutes;

      const average =
        learningData.scores.length
          ? Math.round(
              learningData.scores.reduce((a, b) => a + b, 0) /
              learningData.scores.length
            )
          : null;

      document.getElementById("score").textContent =
        average === null ? "—" : average + "%";

      document.getElementById("bestScore").textContent =
        learningData.scores.length
          ? Math.max(...learningData.scores) + "%"
          : "—";
    }

    function toggleDarkMode(checkbox) {
      if (checkbox.checked) {
        document.body.style.background = "#101625";
        document.body.style.color = "#f5f7ff";
      } else {
        document.body.style.background = "#f4f7ff";
        document.body.style.color = "#172033";
      }
    }

    function escapeHTML(text) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }
  </script>

</body>
</html>
